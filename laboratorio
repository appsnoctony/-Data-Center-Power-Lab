/* ---- Los 3 tipos de UPS ---- */
let u3ev=null, u3Tok=0;
const U3ST={
  offline:{
    corte:'🟡 Transfirió a batería tras un <b>hueco de 2–10 ms</b>: la carga sí lo sufrió. Batería: SÍ. Es el UPS más básico y económico.',
    sag:'🟡 Detectó el sag y transfirió a batería (2–10 ms). Gasta batería para algo que un AVR resolvería sin usarla.',
    surge:'🔴 <b>No corrige</b> activamente: la sobretensión pasó a la carga (solo protección limitada tipo MOV).'},
  linea:{
    corte:'🟡 Transfirió a inversor en <b>2–4 ms</b> (hueco breve; la mayoría de fuentes lo toleran). Batería: SÍ.',
    sag:'🟢 El <b>AVR</b> corrigió el sag cambiando taps del autotransformador: <b>sin usar batería</b>.',
    surge:'🟢 El <b>AVR</b> recortó la sobretensión con sus taps: <b>sin usar batería</b>.'},
  online:{
    corte:'🟢 <b>0 ms.</b> La onda se regenera siempre: la batería alimentó el Bus DC sin conmutar nada. La carga jamás lo nota.',
    sag:'🟢 El sag murió en el rectificador: la carga recibió onda perfecta. <b>Batería: ni siquiera se usó.</b>',
    surge:'🟢 La doble conversión regenera la onda: la carga no vio nada. <b>Batería: ni siquiera se usó.</b>'}
};
function ampU3(kind,x){
  if(!u3ev)return 1;
  const ev=0.42;
  if(kind==='online')return 1;
  if(kind==='offline'){
    if(u3ev==='corte')return x<ev?1:(x<ev+0.05?0.06:1);
    if(u3ev==='sag')return x<ev?1:(x<ev+0.07?0.55:1);
    return x<ev?1:1.18;
  }
  if(u3ev==='corte')return x<ev?1:(x<ev+0.035?0.12:1);
  if(u3ev==='sag')return x<ev?1:(x<ev+0.03?0.55:1);
  return x<ev?1:(x<ev+0.03?1.2:1);
}
function drawU3(i,p){
  const cv=$('u3c'+i), ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height,mid=H/2;
  ctx.clearRect(0,0,W,H);
  ctx.strokeStyle='#24365c'; ctx.setLineDash([4,4]);
  ctx.beginPath(); ctx.moveTo(0,mid-30); ctx.lineTo(W,mid-30); ctx.stroke(); ctx.setLineDash([]);
  ctx.fillStyle='#93a5c4'; ctx.font='11px Segoe UI';
  ctx.fillText('tensión nominal en la carga',8,14);
  const kinds=['offline','linea','online'], cycles=15, ev=0.42;
  if(u3ev&&p>ev){
    ctx.strokeStyle='#fbbf24'; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(W*ev,6); ctx.lineTo(W*ev,H-6); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='#fbbf24'; ctx.fillText('evento',W*ev+4,H-6);
  }
  ctx.lineWidth=2.2; ctx.strokeStyle=['#38bdf8','#fbbf24','#4ade80'][i];
  ctx.beginPath();
  const lim=W*p;
  for(let px=0;px<=lim;px+=2){
    const x=px/W, a=ampU3(kinds[i],x);
    const y=mid-30*a*Math.sin(x*cycles*2*Math.PI);
    px===0?ctx.moveTo(px,y):ctx.lineTo(px,y);
  }
  ctx.stroke(); ctx.lineWidth=1;
}
for(let i=0;i<3;i++)drawU3(i,1);
document.querySelectorAll('[data-ev]').forEach(b=>b.onclick=()=>{
  u3ev=b.dataset.ev; u3Tok++; const my=u3Tok; seen('tipos');
  document.querySelectorAll('[data-ev]').forEach(x=>x.className=x===b?'btn':'btn gh');
  const t0=performance.now();
  (function fr(){
    if(u3Tok!==my)return;
    const p=Math.min(1,(performance.now()-t0)/1400);
    for(let i=0;i<3;i++)drawU3(i,p);
    if(p<1)requestAnimationFrame(fr);
    else{
      const ids=['u3s0','u3s1','u3s2'], kinds=['offline','linea','online'];
      ids.forEach((id,i)=>$(id).innerHTML=U3ST[kinds[i]][u3ev]);
    }
  })();
});

