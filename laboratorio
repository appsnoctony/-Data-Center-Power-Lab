  ctx.strokeStyle=ok?'#4ade80':'#f87171'; ctx.lineWidth=2.2; ctx.beginPath();
  const cyc=6*f/60;
  for(let x=0;x<=880;x+=2){
    const y=oy-A*Math.sin(x/880*cyc*2*Math.PI+gv.ph);
    x===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  }
  ctx.stroke(); ctx.lineWidth=1;
  ctx.fillStyle='#93a5c4'; ctx.font='12px Segoe UI';
