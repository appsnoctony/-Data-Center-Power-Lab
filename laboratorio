function htAxes(ctx){
  const W=900,H=260,L=52,T=16,R=16,B=34;
  const xOf=t=>L+(t/90)*(W-L-R), yOf=v=>T+(1-(v-20)/(95-20))*(H-T-B);
  ctx.strokeStyle='#24365c'; ctx.fillStyle='#93a5c4'; ctx.font='11px Segoe UI';
  [20,40,60,80,95].forEach(v=>{
    ctx.beginPath(); ctx.moveTo(L,yOf(v)); ctx.lineTo(W-R,yOf(v)); ctx.stroke();
    ctx.fillText(v+'°',10,yOf(v)+4);
  });
  [0,15,30,45,60,75,90].forEach(t=>ctx.fillText(t+'s',xOf(t)-8,H-14));
  ctx.strokeStyle='#4ade80'; ctx.setLineDash([5,4]);
  ctx.beginPath(); ctx.moveTo(L,yOf(75)); ctx.lineTo(W-R,yOf(75)); ctx.stroke(); ctx.setLineDash([]);
  ctx.fillStyle='#4ade80'; ctx.fillText('75 °C = listo para aceptar 100% de carga',L+8,yOf(75)-6);
  return {xOf,yOf};
}
function htDraw(){
  const ctx=$('htCv').getContext('2d');
  ctx.clearRect(0,0,900,260);
  const {xOf,yOf}=htAxes(ctx);
  [['on','#f59e0b','Calentador ON'],['off','#38bdf8','Calentador OFF']].forEach(([k,c,lab],i)=>{
    if(htData[k]&&htData[k].length){
      ctx.strokeStyle=c; ctx.lineWidth=2.5; ctx.beginPath();
      htData[k].forEach((T,j)=>{ const x=xOf(j*0.5), y=yOf(T); j===0?ctx.moveTo(x,y):ctx.lineTo(x,y); });
      ctx.stroke(); ctx.lineWidth=1;
    }
    ctx.fillStyle=c; ctx.fillRect(700+i*110,10,14,10);
    ctx.font='11px Segoe UI'; ctx.fillText(lab,720+i*110,19);
  });
}
