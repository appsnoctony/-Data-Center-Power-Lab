  document.querySelectorAll('[data-hs]').forEach(x=>x.className=x===b?'btn':'btn gh');
});
 $('hmSp').oninput=e=>{ hm.sp=+e.target.value; $('hmSpL').textContent=hm.sp; seen('humproc'); };
 $('hmAuto').onclick=()=>{ hm.auto=true; hm.humReq=hm.dehReq=false; updHumBtns(); seen('humproc'); };
 $('hmHumM').onclick=()=>{ hm.auto=false; hm.humOn=!hm.humOn; if(hm.humOn)hm.dehOn=false; updHumBtns(); seen('humproc'); };
 $('hmDehM').onclick=()=>{ hm.auto=false; hm.dehOn=!hm.dehOn; if(hm.dehOn)hm.humOn=false; updHumBtns(); seen('humproc'); };
updHumBtns();

/* ---- loop de animación ---- */
function tick(t){
  if($('m1').classList.contains('act')){ drawAC(t); drawBat(t); }
  else if($('m3').classList.contains('act')){ drawGV(); }
  else if($('m4').classList.contains('act')){ drawHum(t); }
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);
</script>
</body>
