    if(ref){ const rx=60+560*ref/max; ctx.strokeStyle='#e6edf7'; ctx.setLineDash([4,3]);
      ctx.beginPath(); ctx.moveTo(rx,y); ctx.lineTo(rx,y+20); ctx.stroke(); ctx.setLineDash([]); }
    ctx.fillStyle='#e6edf7'; ctx.font='bold 11px Segoe UI';
    ctx.fillText(val.toFixed(0)+unit,630,y+14);
  }
  bar(140,'RPM del motor (línea blanca = 1800 RPM)',gv.rpm,2000,' rpm',gv.auto?'#38bdf8':'#93a5c4',1800);
  bar(175,'Frecuencia de salida (línea blanca = 60 Hz)',f,70,' Hz',ok?'#4ade80':'#f87171',60);
  bar(210,'Combustible inyectado'+(gv.auto?' (lo mueve el gobernador)':' (manual)'),gv.fuel,100,'%','#f59e0b',null);
  ctx.fillStyle='#64748b'; ctx.font='11px Segoe UI';
  ctx.fillText('Carga aplicada: '+gv.load+'%',740,140);
  // panel de estado
  if(++gv.uiN%12===0){
    const dev=f-60;
    let s='<b>Modo:</b> '+(gv.auto?'🤖 Automático (gobernador persigue 1800 RPM)':'✋ Manual (combustible fijo)')
      +' · <b>Carga:</b> '+gv.load+'% · <b>Desvío:</b> '+(dev>=0?'+':'')+dev.toFixed(2)+' Hz';
    if(gv.evT!==null&&gv.recoverT!==null){
      const mx=Math.max(Math.abs(60-gv.minHz),Math.abs(gv.maxHz-60));
      s+='<br>📈 Último evento: desvío máximo <b>'+mx.toFixed(1)+' Hz</b> · recuperó 60 Hz en <b>'+gv.recoverT.toFixed(1)+' s</b>'
        +(gv.auto?' (abriendo combustible hasta '+Math.round(gv.fuel)+'%)':'');
    }
    $('gvState').innerHTML=s;
  }
}

