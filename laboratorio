  const T0=on?45:23, k=on?0.13:0.032, crank=on?1.5:3;
  let readyT=null, lCrank=false, l40=false, lAcc=false;
  const L=$('htLog');
  const add=h=>{ const li=document.createElement('li'); li.innerHTML=h; L.prepend(li); };
  add(on?'🚀 Arranque ordenado — refrigerante a 45 °C (calentador ON)':'🚀 Arranque ordenado — refrigerante FRÍO a 23 °C (calentador OFF)');
  for(let i=0;i<=180;i++){
    if(htRun!==my){ htBusy=false; return; }
    const t=i*0.5; let T;
    if(t<crank)T=T0; else T=90-(90-T0)*Math.exp(-(t-crank)*k);
    htData[key].push(T);
    if(!lCrank&&t>=crank){ lCrank=true; add(on?'🔥 Motor precalentado: arranque inmediato y suave.':'🧊 Motor frío: girando con aceite viscoso — arranque prolongado…'); }
    if(!on&&!l40&&T>=40){ l40=true; add('⚠️ Choque térmico: expansión desigual de los metales → desgaste interno.'); }
    if(on&&!lAcc&&t>=crank+1){ lAcc=true; add('⚙️ Aceptando carga progresiva…'); }
    if(readyT===null&&T>=75){ readyT=t; add('<b class="okT">✅ LISTO para aceptar 100% de carga (t='+t.toFixed(1)+' s)</b>'); }
    htDraw();
    await new Promise(r=>setTimeout(r,30));
  }
  htReady[key]=readyT;
  const line=[];
  if(htReady.on!=null)line.push('🔥 ON: listo en <b>'+htReady.on.toFixed(1)+' s</b>');
  if(htReady.off!=null)line.push('🧊 OFF: listo en <b>'+htReady.off.toFixed(1)+' s</b> + desgaste por choque térmico');
  $('htReady').innerHTML=line.join(' &nbsp;·&nbsp; ');
  if(!on)add('💡 El calentador de camisas (1–3 kW continuos) habría reducido este tiempo a ~10 s y evitado el choque térmico.');
  else add('🎯 1–3 kW continuos compran segundos críticos y vida útil del motor.');
  htBusy=false;
};
