/* ---- Circuito de humidificación / deshumidificación ---- */
const hm={rh:47,sp:50,scen:'estable',auto:true,humOn:false,dehOn:false,humReq:false,dehReq:false,
  humT:0,dehT:0,fan:0,ph:0,steam:[],drops:[],drain:[],hist:[],lastT:0,uiN:0};
function hmTick(dt){
  if(hm.scen==='seco')hm.rh-=0.5*dt;
  else if(hm.scen==='humedo')hm.rh+=0.5*dt;
  else hm.rh+=(50-hm.rh)*0.01*dt;
  if(hm.humOn)hm.rh+=2.4*dt;
  if(hm.dehOn)hm.rh-=2.4*dt;
  if(hm.auto){
    if(hm.rh<hm.sp-2.5)hm.humReq=true; else if(hm.rh>hm.sp-0.5)hm.humReq=false;
    if(hm.rh>hm.sp+2.5)hm.dehReq=true; else if(hm.rh<hm.sp+0.5)hm.dehReq=false;
    hm.humOn=hm.humReq&&!hm.dehReq;
    hm.dehOn=hm.dehReq&&!hm.humReq;
  }
  hm.rh=Math.min(85,Math.max(20,hm.rh));
  if(hm.humOn)hm.humT+=dt; else hm.humT=0;
  if(hm.dehOn)hm.dehT+=dt; else hm.dehT=0;
  hm.hist.push(hm.rh); if(hm.hist.length>200)hm.hist.shift();
  hm.fan+=7*dt; hm.ph+=90*dt;
  if(hm.humOn)for(let i=0;i<2;i++)hm.steam.push({x:592+(Math.random()*18-9),y:196,vy:-(34+Math.random()*22),vx:(Math.random()-0.5)*10,life:1});
  hm.steam.forEach(p=>{p.y+=p.vy*dt;p.x+=p.vx*dt;p.life-=dt*0.75;});
  hm.steam=hm.steam.filter(p=>p.life>0);
  if(hm.dehOn&&Math.random()<0.4)hm.drops.push({x:440+Math.random()*66,y:150+Math.random()*50,vy:80});
  hm.drops.forEach(p=>p.y+=p.vy*dt);
  hm.drops=hm.drops.filter(p=>p.y<206);
  if(hm.dehOn)hm.drain.push({p:0});
  hm.drain.forEach(p=>p.p+=dt*0.55);
  hm.drain=hm.drain.filter(p=>p.p<1);
}
function stepIdx(T){ return T<=0?-1:Math.min(4,Math.floor(T/1.4)); }
function updSteps(){
  const ih=stepIdx(hm.humT), idd=stepIdx(hm.dehT);
