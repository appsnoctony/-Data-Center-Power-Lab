<script>
"use strict";
const $=id=>document.getElementById(id);
const SEEN=new Set(), TOTAL=15;
function seen(k){ if(SEEN.has(k))return; SEEN.add(k); $('seenN').textContent=SEEN.size;
  if(SEEN.size===TOTAL)$('prog').textContent='🎉 ¡15/15 simuladores explorados! Estás listo para la práctica en sitio.'; }

/* ---- tabs ---- */
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('act'));
  document.querySelectorAll('section').forEach(x=>x.classList.remove('act'));
  b.classList.add('act'); $(b.dataset.s).classList.add('act');
  window.scrollTo({top:0});
});

/* ---- AC/DC ---- */
let acMode=true, acF=1;
 $('btnAC').onclick=()=>{acMode=true;$('btnAC').className='btn';$('btnDC').className='btn gh';
  $('acdcInfo').innerHTML='<b>AC (Corriente Alterna):</b> la corriente cambia de sentido periódicamente — por eso la onda sube y baja cruzando el cero. En la red: 60 ciclos por segundo (60 Hz). <i>Analogía: la marea que va y viene.</i>'; seen('acdc');};
 $('btnDC').onclick=()=>{acMode=false;$('btnDC').className='btn';$('btnAC').className='btn gh';
  $('acdcInfo').innerHTML='<b>DC (Corriente Continua):</b> la corriente fluye <b>siempre en una sola dirección</b> — línea constante, sin cruzar el cero. Así trabajan las baterías. <i>Analogía: el río que fluye en un solo sentido.</i>'; seen('acdc');};
 $('fSlider').oninput=e=>{acF=+e.target.value;$('fLbl').textContent=acF.toFixed(1);seen('acdc');};

const acCv=$('acdcCv'), acx=acCv.getContext('2d');
function drawAC(t){
  const W=acCv.width,H=acCv.height; acx.clearRect(0,0,W,H);
  const mid=70, A=45, tp=t/1000;
  acx.strokeStyle='#24365c'; acx.beginPath(); acx.moveTo(0,mid); acx.lineTo(W,mid); acx.stroke();
  acx.strokeStyle=acMode?'#38bdf8':'#4ade80'; acx.lineWidth=2.5; acx.beginPath();
  for(let x=0;x<=W;x+=2){
    const y=acMode? mid - A*Math.sin(x/70*acF + tp*2*acF) : mid;
    x===0? acx.moveTo(x,y):acx.lineTo(x,y);
  } acx.stroke();
  if(acMode){acx.strokeStyle='#fbbf24';acx.setLineDash([4,4]);acx.beginPath();acx.moveTo(0,mid-A);acx.lineTo(W,mid-A);acx.moveTo(0,mid+A);acx.lineTo(W,mid+A);acx.stroke();acx.setLineDash([]);}
  acx.fillStyle='#93a5c4'; acx.font='12px Segoe UI';
  acx.fillText(acMode?'Forma de onda AC — la corriente invierte su sentido':'Forma de onda DC — polaridad constante',14,20);
  const ty=170;
  acx.strokeStyle='#24365c'; acx.strokeRect(40,ty-32,W-80,64);
  const n=16, sp=(W-110)/n;
  for(let i=0;i<n;i++){
    let x;
    if(acMode){ x=85+i*sp + 22*Math.sin(tp*2*acF*2 + i*0.9); }
    else{ x=85+((i*sp + tp*80) % (W-110)); }
    const g=acx.createRadialGradient(x,ty,1,x,ty,7);
    g.addColorStop(0,acMode?'#7dd3fc':'#86efac'); g.addColorStop(1,acMode?'#0369a1':'#15803d');
    acx.fillStyle=g; acx.beginPath(); acx.arc(x,ty,7,0,7); acx.fill();
  }
  acx.fillStyle='#e6edf7'; acx.font='bold 13px Segoe UI';
  acx.fillText(acMode?'← electrones oscilan: van y vienen →':'→ electrones: siempre el mismo sentido →',60,ty+55);
}

/* ---- Transmisión ---- */
 $('txV').oninput=e=>{
  const V=+e.target.value; $('txVl').textContent=V;
  const I=100e6/(V*1e3), Irel=I/(1e6/(100*1e3));
  $('txI').textContent=Math.round(I).toLocaleString('es')+' A';
  const p=Math.round(Irel*Irel*100); $('txP').textContent=p+'%';
  $('txP').style.color=p<40?'var(--vd)':(p<100?'var(--am)':'var(--rj)');
  $('txMsg').innerHTML = V>=200
    ? '✅ Voltaje alto: la corriente baja y las pérdidas se reducen drásticamente. <b>Así viaja la energía a largas distancias.</b>'
    : '⚠️ Voltaje bajo: la corriente es enorme y las pérdidas (I²R) se disparan. <b>Los transformadores (¡AC!) permiten elevar el voltaje y resolver esto.</b>';
  seen('tx');
};

/* ---- Factor de potencia ---- */
 $('fpS').oninput=e=>{
  const fp=+e.target.value; $('fpLbl').textContent=fp.toFixed(2); seen('fp');
  const L=120, base=L*fp, alt=L*Math.sqrt(1-fp*fp);
  $('triP').setAttribute('d',`M 50 175 L ${50+base} 175 L 50 ${175-alt} Z`);
  $('triKw').setAttribute('x',50+base/2-14); $('triKw').textContent='kW '+Math.round(fp*100);
  $('triKvar').setAttribute('y',175-alt/2); $('triKvar').textContent='kVAR '+Math.round(alt);
  $('triKva').setAttribute('x',50+base/2+10); $('triKva').setAttribute('y',175-alt/2-8); $('triKva').textContent='kVA 100';
  $('beer').style.height=(fp*100)+'%';
  $('fpKw').textContent=Math.round(fp*100)+' kW';
  $('fpKvar').textContent=Math.round(alt)+' kVAR';
};

/* ---- Estrella Y ---- */
 $('yV').oninput=e=>{
  const V=+e.target.value; $('yVl').textContent=V; seen('y');
  const r=V*0.45, cx=150, cy=150;
  const p1=[cx,cy-r], p2=[cx+r*0.866,cy+r*0.5], p3=[cx-r*0.866,cy+r*0.5];
  const set=(id,p,q)=>{$(id).setAttribute('x1',p[0]);$(id).setAttribute('y1',p[1]);$(id).setAttribute('x2',q[0]);$(id).setAttribute('y2',q[1]);};
  set('yl1',[cx,cy],p1); set('yl2',[cx,cy],p2); set('yl3',[cx,cy],p3); set('yLin',p1,p2);
  $('yF1t').setAttribute('y',cy-r-10); $('yF2t').setAttribute('x',cx+r*0.866+6); $('yF2t').setAttribute('y',cy+r*0.5+4);
  $('yF3t').setAttribute('x',cx-r*0.866-26); $('yF3t').setAttribute('y',cy+r*0.5+4);
  $('yLL').setAttribute('x',(p1[0]+p2[0])/2+26); $('yLL').setAttribute('y',(p1[1]+p2[1])/2-6);
