function drawGV(){
  // física: el punto de equilibrio depende del combustible y la carga
  const target=gv.fuel*30 - gv.load*4;
  gv.rpm+=(target-gv.rpm)*0.028;
  if(gv.rpm<0)gv.rpm=0;
  if(gv.auto){
    const err=1800-gv.rpm;
    gv.fuel=Math.min(100,Math.max(3,gv.fuel+err*0.0018));
    $('gvFuelLbl').textContent=Math.round(gv.fuel)+'%';
  }
  const f=gvF(); gv.ph+=f*0.0022;
  if(gv.evT!==null){
    gv.evT+=1/60;
    gv.minHz=Math.min(gv.minHz,f); gv.maxHz=Math.max(gv.maxHz,f);
    if(gv.recoverT===null&&Math.abs(f-60)<=0.3)gv.recoverT=gv.evT;
  }
  const ctx=$('gvCv').getContext('2d'); ctx.clearRect(0,0,900,250);
  const ok=Math.abs(f-60)<=0.5;
