  ctx.fillText(f.toFixed(1)+' Hz  '+(ok?'✓ DENTRO DE ESPEC (60 ± 0.5)':'✗ FUERA DE ESPEC — riesgo para los equipos TI'),20,38);
  // barras
  function bar(y,label,val,max,unit,col,ref){
    ctx.fillStyle='#93a5c4'; ctx.font='11px Segoe UI'; ctx.fillText(label,60,y-5);
    ctx.fillStyle='#1a2745'; ctx.fillRect(60,y,560,20);
